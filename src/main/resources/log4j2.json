{
    "configuration": {
        "status": "error",
        "name": "structured-logger",
        "packages": "uk.gov.companieshouse.logging.layout.log4j",
        "appenders": {
            "Console": {
                "name": "STDOUT",
                "StructuredLayout": {
                    "pretty": "${env:HUMAN_LOG:-0}"
                }
            },
            "OpenTelemetry": {
                "name": "OpenTelemetryAppender"
            }
        },
        "loggers": {
           "logger": {
              "name": "uk.gov",
              "level": "${env:LOGLEVEL:-trace}",
              "additivity": false,
              "AppenderRef": [
                 { "ref": "STDOUT" },
                 { "ref": "OpenTelemetryAppender" }
              ]
           },
           "root": {
              "level": "${env:LOGLEVEL_THIRDPARTY:-info}",
              "AppenderRef": [
                 { "ref": "STDOUT" },
                 { "ref": "OpenTelemetryAppender" }
              ]
           }
        }
    }
}
